+
+      it "clears the report when a blank report_token is provided" do
+        form = BudgetForm.new(
+          token: budget.token,
+          name: budget.name,
+          organization:,
+          report_token: "",
+          periods_attributes: {},
+          type: "Budget"
+        )
+
+        assert form.save
+        assert_nil budget.reload.report_id
+      end
+
+      it "reassigns the report when another report_token is provided" do
+        other_report = FactoryBot.create(:cost_report, organization:)
+
+        form = BudgetForm.new(
+          token: budget.token,
+          name: budget.name,
+          organization:,
+          report_token: other_report.token,
+          periods_attributes: {},
+          type: "Budget"
+        )
+
+        assert form.save
+        assert_equal other_report.id, budget.reload.report_id
+      end
+    end
+
     describe "period interval" do
